# Bluetooth Configuration (Classic only, no BLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y


# Wi-Fi Configuration
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=6

# Software RF Coexistence (Wi-Fi + Classic Bluetooth A2DP arbitration)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# TCP/IP and HTTP Server
CONFIG_ESP_NETIF_TCPIP_LWIP=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512


# CPU: run at 240 MHz for FLAC decode headroom
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS tick rate: 1000Hz = 1ms resolution
# Default 100Hz (10ms ticks) causes timing problems:
#   - pdMS_TO_TICKS(5) rounds to 0 (no wait at all)
#   - Pre-buffer 300x10ms = 3s blocks console task near TWDT limit
#   - BT ACL scheduler misses 20ms timing windows causing disconnects
CONFIG_FREERTOS_HZ=1000

# Task Watchdog: 10s timeout (large FLAC metadata parse can take 2-3s)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Flash Size (4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# External PSRAM (ESP_PSRAM64H on HW-297)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# FATFS: enable long filename support for audio file names
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
